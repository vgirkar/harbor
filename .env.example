# ---- Runtime ---------------------------------------------------------------
APP_ENV=dev                     # dev | prod (prod switches logs to JSON)
LOG_LEVEL=INFO
API_KEYS=dev-key                # comma separated client keys for /v1/*
ADMIN_API_KEY=dev-admin-key     # required for /v1/ingest*
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MINUTE=60

# ---- Postgres (system of record + pgvector + LangGraph checkpoints) --------
DATABASE_URL=postgresql+psycopg://harbor:harbor@localhost:5432/harbor

# ---- LLM (Anthropic Claude) ------------------------------------------------
LLM_PROVIDER=anthropic          # anthropic | fake (fake = deterministic offline mode)
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5-5    # grounded answers, small talk
FAST_MODEL=claude-haiku-4-5     # router, injection classifier, LLM reranker, ticket summaries
VERIFIER_MODEL=claude-sonnet-5-5 # groundedness verifier and offline LLM-as-judge
ANSWER_EFFORT=medium            # low | medium | high (ignored on models without effort)

# ---- Embeddings -------------------------------------------------------------
EMBEDDINGS_PROVIDER=voyage      # voyage | openai | fake
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=1024              # must match the vector(…) column; see alembic 0001
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Vector index -----------------------------------------------------------
VECTOR_BACKEND=pgvector         # pgvector | pinecone
PINECONE_API_KEY=
PINECONE_INDEX=harbor-chunks
PINECONE_NAMESPACE=default

# ---- Retrieval --------------------------------------------------------------
RERANKER=voyage                 # voyage | llm | none
RERANK_MODEL=rerank-2.5
DENSE_TOP_K=20
LEXICAL_TOP_K=20
RERANK_TOP_N=6
RRF_K=60
MIN_RELEVANCE=0.15              # below this the knowledge agent says it does not know

# ---- Guardrails -------------------------------------------------------------
GUARD_LLM_MODE=uncertain        # always | uncertain | never
GUARD_BLOCK_THRESHOLD=0.7       # LLM classifier confidence needed to block
GUARD_HARD_BLOCK_SCORE=0.9      # heuristic score that blocks without asking the LLM
MAX_ANSWER_ATTEMPTS=2

# ---- Voice ------------------------------------------------------------------
SPEECH_PROVIDER=elevenlabs      # elevenlabs | openai | fake
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ---- Observability (optional) ----------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=harbor
